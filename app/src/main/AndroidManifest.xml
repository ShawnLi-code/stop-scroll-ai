<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络请求权限（AI 大模型 API） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 悬浮窗/顶层弹窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 震动权限（偏离目标/超时强震动提醒） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 保活与白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 查询前台活跃包名（辅助无障碍） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 允许在应用内调起系统安装器进行覆盖安装更新（不丢数据、不重置权限） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 查询手机内已安装应用（用于自定义勾选/添加监控应用） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".StopScrollApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.StopScroll">

        <!-- 主设置页面 (excludeFromRecents="true" 防止在多任务列表被手滑划掉导致无障碍断连) -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 拦截与强中断 Activity（全屏覆盖、排除多任务、防止事件穿透） -->
        <activity
            android:name=".InterceptDialogActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.StopScroll.Dialog" />

        <!-- 使用历史与统计看板 Activity -->
        <activity
            android:name=".HistoryActivity"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- 手机已安装应用选择器 Activity -->
        <activity
            android:name=".AppPickerActivity"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- 核心无障碍监控服务 -->
        <service
            android:name=".service.StopScrollAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- FileProvider 支持应用内直接下载并调起系统覆盖安装更新 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
